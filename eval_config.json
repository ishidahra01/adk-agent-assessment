          }
        },
        {
          "rubric_id": "courtesy_and_helpfulness",
          "rubric_content": {
            "text_property": "カスタマーサポートとして丁寧かつ親切で共感的なトーンを保ち、必要に応じて具体的な次のアクション（箇条書き等）を分かりやすく提示している。"
          }
        }
      ]
    }
  }
